// SOC-AFSEC CRM data model
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users / Roles ────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      String   @default("admin") // "admin" | "operator"
  createdAt DateTime @default(now())

  // Force password change on next sign-in.
  mustChangePassword Boolean @default(false)

  // 2FA / TOTP.
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  totpEnrolledAt DateTime?

  // Account lockout (admin unlocks by clearing lockedAt).
  lockedAt   DateTime?
  lockReason String?

  // Operators are bound to one Location.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  scanLogs  ScanLog[]
  auditLogs AdminAuditLog[]
}

model LoginAttempt {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  ipAddress String
  email     String?
  succeeded Boolean  @default(false)

  @@index([ipAddress, at])
  @@index([at])
}

model AdminAuditLog {
  id String @id @default(cuid())
  at DateTime @default(now())

  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action     String // "guard.create" | "guard.update" | …
  entityType String
  entityId   String?
  summary    String?
  changes    Json?

  ipAddress String?
  userAgent String?

  @@index([at])
  @@index([actorId, at])
  @@index([entityType, entityId])
}

// ─── Locations ────────────────────────────────────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  type      String   @default("site")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operators User[]
  scanLogs  ScanLog[]
}

// ─── Scan log ─────────────────────────────────────────────────────────────

model ScanLog {
  id        String   @id @default(cuid())
  scannedAt DateTime @default(now())

  guardId String
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)

  scannedById String
  scannedBy   User   @relation(fields: [scannedById], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  scanType String

  weaponSerial  String?
  permitContext String?

  ipAddress String?
  userAgent String?
  notes     String?

  @@index([scannedAt])
  @@index([locationId, scannedAt])
  @@index([guardId, scannedAt])
}

// ─── Guards / Trainings ───────────────────────────────────────────────────

model Guard {
  id         String  @id @default(cuid())
  slug       String  @unique
  employeeId String? @unique

  firstName String
  lastName  String
  jobTitle  String
  photoUrl  String?

  status String @default("active")

  permit1Active       Boolean   @default(false)
  permit1Number       String?
  permit1WeaponNumber String?
  permit1Make         String?
  permit1Model        String?
  permit1Clips        Int?
  permit1IssueDate    DateTime?
  permit1ExpiryDate   DateTime?
  permit1DocumentUrl  String?

  permit2Active       Boolean   @default(false)
  permit2Number       String?
  permit2WeaponNumber String?
  permit2Make         String?
  permit2Model        String?
  permit2Clips        Int?
  permit2IssueDate    DateTime?
  permit2ExpiryDate   DateTime?
  permit2DocumentUrl  String?

  visaStatus      String    @default("inactive")
  visaNumber      String?
  visaIssueDate   DateTime?
  visaExpiryDate  DateTime?
  visaDocumentUrl String?

  medicalClearanceDate DateTime?
  medicalExpiryDate    DateTime?
  medicalDocumentUrl   String?

  notes String?

  // Soft delete — restorable from /admin/trash for 30 days.
  deletedAt DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  trainings Training[]
  scanLogs  ScanLog[]
  documents GuardDocument[]

  @@index([deletedAt])
}

// File inspection checklist — one row per required document type.
// docType is one of the keys in src/lib/documents.ts.
model GuardDocument {
  id      String @id @default(cuid())
  guardId String
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)

  docType     String // e.g. "arming_approval", "passport_copy"
  documentUrl String?
  issueDate   DateTime?
  expiryDate  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guardId, docType])
  @@index([guardId])
}

model Training {
  id      String @id @default(cuid())
  guardId String
  guard   Guard  @relation(fields: [guardId], references: [id], onDelete: Cascade)

  name        String
  issuer      String?
  issueDate   DateTime?
  expiryDate  DateTime?
  active      Boolean   @default(true)
  documentUrl String?

  createdAt DateTime @default(now())
}
